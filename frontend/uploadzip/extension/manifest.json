{
  "manifest_version": 3,
  "name": "Monitar",
  "version": "0.2.2",
  "description": "Start a session, browse, and Monitar tracks your tabs and saves them to your account.",
  "permissions": ["tabs", "storage", "alarms", "tabGroups"],
  "host_permissions": ["https://monitar.up.railway.app/*"],
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Monitar",
    "default_icon": {
      "16": "icons/icon_16.png",
      "32": "icons/icon_32.png",
      "48": "icons/icon_48.png",
      "128": "icons/icon_128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }

}
